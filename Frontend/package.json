{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verificar-recorridos.mjs && tsc -b && vite build",
    "test": "node --test 'tests/*.test.mjs'",
    "test:e2e": "playwright test",
    "capturas": "playwright test --config playwright.capturas.config.mjs",
    "recorridos:verificar": "node scripts/verificar-recorridos.mjs",
    "recorridos:huellas": "node scripts/verificar-recorridos.mjs --actualizar-huellas",
    "recorridos:listar": "node scripts/listar-recorridos.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "gray-matter": "^4.0.3",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "minisearch": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tsparticles-slim": "^2.12.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "react-tsparticles": "^2.12.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.2"
  }
}
