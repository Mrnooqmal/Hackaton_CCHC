{
    "name": "build-and-serve-backend",
    "version": "1.0.0",
    "description": "Backend serverless para sistema de prevención de riesgos",
    "main": "index.js",
    "scripts": {
        "dev": "serverless offline start --httpPort 3001",
        "deploy": "serverless deploy --stage dev",
        "deploy:dev": "serverless deploy --stage dev",
        "deploy:prod": "serverless deploy --stage prod",
        "print:dev": "serverless print --stage dev",
        "print:prod": "serverless print --stage prod",
        "remove": "serverless remove --stage dev",
        "test": "node --test tests/*.test.js"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.700.0",
        "@aws-sdk/client-kms": "^3.1138.0",
        "@aws-sdk/client-s3": "^3.700.0",
        "@aws-sdk/client-ses": "^3.700.0",
        "@aws-sdk/client-sns": "^3.700.0",
        "@aws-sdk/client-sqs": "^3.1092.0",
        "@aws-sdk/client-ssm": "^3.1135.0",
        "@aws-sdk/lib-dynamodb": "^3.700.0",
        "@aws-sdk/s3-request-presigner": "^3.700.0",
        "@google/generative-ai": "^0.24.1",
        "exceljs": "^4.4.0",
        "itty-router": "^5.0.22",
        "jspdf-autotable": "^5.0.7",
        "pdf-lib": "^1.17.1",
        "rut.js": "^2.1.0",
        "uuid": "^11.1.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "cross-env": "^7.0.3",
        "serverless": "^4.0.0",
        "serverless-offline": "^14.0.0",
        "serverless-prune-plugin": "^2.1.0"
    }
}
